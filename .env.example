# Email: SendGrid (recommended). Create an API key with "Mail Send" permission and
# verify the sender address/domain in SendGrid → Settings → Sender Authentication.
SENDGRID_API_KEY=
MAIL_FROM=Krishan Tours Website <info@krishantours.com>

# Alternative: SMTP (used only when SENDGRID_API_KEY is empty).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=iwantu226@gmail.com
SMTP_PASS=replace-with-google-app-password
SMTP_FROM=KrishanTours Website <iwantu226@gmail.com>
CONTACT_TO_EMAIL=iwantu226@gmail.com
INQUIRY_DATA_DIR=/home/ubuntu/tours-data/inquiries
INQUIRY_DB_PATH=/home/ubuntu/tours-data/inquiries/inquiries.db

# Create a scrypt password hash and a long random session secret before launch.
ADMIN_USERNAME=krishan
ADMIN_PASSWORD_HASH=salt:hex-encoded-scrypt-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_GA_ID=G-Q73YFBCYLS

# Optional: Google Business Profile "Ask for reviews" link (g.page/r/.../review)
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Required for admin-configured PayHere credentials. Generate once: openssl rand -hex 32
# Keep stable and back up securely with the database. Do not expose in NEXT_PUBLIC variables.
PAYMENT_ENCRYPTION_KEY=
